# ─────────────────────────────────────────────────────────────
# Chatbot configuration
# ─────────────────────────────────────────────────────────────

# Server-only. NEVER prefix these with NEXT_PUBLIC_ (that would expose them
# to the browser bundle). Vercel reads them from the project settings.

# OpenCode Go API key. Required when CHAT_PROVIDER=opencode-go.
OPENCODE_API_KEY=

# Active provider: opencode-go | mock
# (anthropic and openai are planned but not implemented yet.)
CHAT_PROVIDER=opencode-go

# Model id used by the provider.
CHAT_MODEL=claude-haiku-5-5

# Kill switch: set to "false" to make /api/chat answer 503.
CHAT_ENABLED=true

# Rate limiting per IP.
CHAT_RATE_LIMIT_PER_MIN=10
CHAT_RATE_LIMIT_PER_DAY=100

# Input limits.
CHAT_MAX_MESSAGES=20
CHAT_MAX_MESSAGE_LENGTH=800

# Future direct integrations (not implemented yet).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────
# Leads persistence + chat analytics (Phase 2)
# ─────────────────────────────────────────────────────────────

# Kill switches. Both default to false: the endpoints answer 503 until enabled.
LEAD_PERSISTENCE_ENABLED=false
CHAT_ANALYTICS_ENABLED=false

# Notification kill switch. When false the lead is persisted but not notified.
LEAD_NOTIFY_ENABLED=false

# Supabase (PostgreSQL). The service role key is SECRET and never exposed to
# the browser; the app only talks to PostgREST from the server route handlers.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secret pepper for sha256(sessionId + pepper). Required when either kill
# switch above is enabled. Generate with: openssl rand -hex 32
SESSION_PEPPER=

# Rate limiting per IP for the new endpoints. `/api/leads` is stricter because
# it persists PII (see Anexo C.8 of the design doc).
LEAD_RATE_LIMIT_PER_MIN=10
LEAD_RATE_LIMIT_PER_DAY=100
EVENT_RATE_LIMIT_PER_MIN=60
EVENT_RATE_LIMIT_PER_DAY=600

# Store implementation. Leave unset in production (Supabase when configured).
# `memory` is opt-in for tests and local development only.
LEAD_STORE=
EVENT_STORE=

# ── Email notification (Gmail + Nodemailer, PRIMARY) ─────────
# The client has no domain to verify in Resend, so Gmail is the main channel.
# GMAIL_APP_PASSWORD is the 16-character Google App Password (not the login
# password). Create it at: Google Account > Security > 2-Step Verification >
# App passwords.
GMAIL_USER=digitaldevscolombia@gmail.com
GMAIL_APP_PASSWORD=
LEAD_NOTIFY_EMAIL=digitaldevscolombia@gmail.com

# ── Email notification (Resend, OPTIONAL secondary) ──────────
# Priority: Resend > Gmail. Resend is only used when RESEND_API_KEY is set and
# requires a verified domain; otherwise Gmail (above) is used.
RESEND_API_KEY=
RESEND_FROM=Leads <leads@digitaldevs.co>

# ── WhatsApp notification (Meta Cloud API, optional) ─────────
# Disabled by default: enable once the Meta Business credentials are in place.
LEAD_NOTIFY_WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Recipient in E.164 format (the business/team number), e.g. 573113609710.
WHATSAPP_NOTIFY_NUMBER=
# Approved template name and language. The template body must define, in
# order: {{1}} name, {{2}} contact, {{3}} source, {{4}} date.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_API_VERSION=v21.0

# Optional annex (design doc section 4.9). Not implemented in this phase.
CHAT_TRANSCRIPTS_ENABLED=false

# ─────────────────────────────────────────────────────────────
# Client-only (safe to expose; read by the widget)
# ─────────────────────────────────────────────────────────────

# Set to "false" to keep the widget from rendering.
NEXT_PUBLIC_CHAT_ENABLED=true
